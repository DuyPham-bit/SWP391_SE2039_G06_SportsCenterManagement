# .NET reads this setting as ConnectionStrings__SportsCenter when provided as an environment variable.
# .NET does not load this file automatically. Import these names into the
# backend/Render environment or use dotnet user-secrets locally.
# Docker Compose uses docker/.env.example names instead.
# For Render, replace the PostgreSQL connection fields and add SSL Mode=Require.
ConnectionStrings__SportsCenter="Host=localhost;Port=5433;Database=SportsCenterManagement;Username=scms;Password=replace-with-postgres-password"

# Generate a private random value of at least 32 bytes; never reuse this example value.
Jwt__Key=replace-with-a-private-random-key-of-at-least-32-bytes
Jwt__Issuer=SportsCenterManagement.API
Jwt__Audience=SportsCenterManagement.FE
Cors__AllowedOrigins__0=http://localhost:3004

# Optional gateway credentials. Configure only the providers enabled for this environment.
VnPay__TmnCode=replace-with-vnpay-merchant-code
VnPay__HashSecret=replace-with-vnpay-hash-secret
VnPay__BaseUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VnPay__ReturnUrl=
VnPay__Version=2.1.0
VnPay__Command=pay
VnPay__CurrCode=VND
VnPay__Locale=vn
Momo__PartnerCode=replace-with-momo-partner-code
Momo__AccessKey=replace-with-momo-access-key
Momo__SecretKey=replace-with-momo-secret-key
Momo__PaymentUrl=https://test-payment.momo.vn/v2/gateway/api/create
Momo__ReturnUrl=
Momo__NotifyUrl=
Momo__RequestType=captureWallet
# Set payment return/IPN URLs to your public deployment URLs, not localhost.
# MoMo NotifyUrl points to https://your-backend-domain/api/payments/momo-ipn.

# Required only when creating the first SystemAdmin in an empty database.
Bootstrap__SystemAdmin__Username=replace-with-admin-username
Bootstrap__SystemAdmin__Email=replace-with-admin-email
Bootstrap__SystemAdmin__Password=replace-with-a-strong-admin-password

# Google Identity Services: same public Web Client ID as VITE_GOOGLE_CLIENT_ID.
Google__ClientId=
# Gemini Free Tier: keep the API key only on the backend.
AI__ApiKey=

# Required for registration verification and password-reset email in every environment.
# Choose SMTP below or an email webhook. The gateway accepts the normalized
# ExternalCommunications payload; use HTTPS (HTTP is permitted only on loopback).
ExternalCommunications__Email__WebhookUrl=
ExternalCommunications__Email__BearerToken=
# SMTP STARTTLS alternative. Leave WebhookUrl empty to use SMTP.
ExternalCommunications__Email__Smtp__Host=smtp.gmail.com
ExternalCommunications__Email__Smtp__Port=587
ExternalCommunications__Email__Smtp__EnableSsl=true
ExternalCommunications__Email__Smtp__From=
ExternalCommunications__Email__Smtp__Username=
ExternalCommunications__Email__Smtp__Password=

# Authentication mail also uses MailSettings. Use the same SMTP credentials above.
MailSettings__Mail=
MailSettings__Password=
MailSettings__Host=smtp.gmail.com
MailSettings__Port=587

# R2 image storage: use the same bucket/domain as the existing uploaded images.
# Corresponds to docker/.env R2_* inputs. Never commit real credentials.
R2Storage__ServiceUrl=https://your-account-id.r2.cloudflarestorage.com
R2Storage__AccessKey=replace-with-access-key
R2Storage__SecretKey=replace-with-secret-key
R2Storage__BucketName=your-bucket-name
R2Storage__PublicDomain=https://your-public-media-domain

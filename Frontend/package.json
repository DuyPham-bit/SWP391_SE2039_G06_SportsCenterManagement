{
  "name": "scms-sports-center-frontend",
  "version": "1.0.0",
  "description": "Sports Center Management System (SCMS) - Frontend Flow Implementation (React + JavaScript)",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "test": "node --test tests/*.test.cjs",
    "test:payment:browser": "node tests/payment-checkout.browser.cjs",
    "test:manager:browser": "node tests/manager-merge.browser.cjs",
    "build": "vite build",
    "build:api": "vite build --outDir ../Backend/Backend/SportsCenterManagement.API/wwwroot --emptyOutDir",
    "preview": "vite preview"
  },
  "keywords": [

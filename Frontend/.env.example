# Local development uses Vite's /api proxy. On Vercel, set this to the HTTPS API
# origin including /api, for example https://api.example.com/api.
VITE_API_BASE_URL=/api
# Vite development/preview proxy destination; this variable stays on the development server.
SCMS_API_PROXY_TARGET=http://localhost:5000
# Active center ID in the current development database; update if using a different database.
VITE_SPORTS_CENTER_ID=15
VITE_GOOGLE_CLIENT_ID=

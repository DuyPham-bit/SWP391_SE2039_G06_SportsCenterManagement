POSTGRES_PASSWORD=replace-with-a-strong-password
# Same names as docker/.env; never replace placeholders with real secrets here.
# Compose maps these inputs to .NET Section__Property settings.
# Direct Render backend configuration uses Backend/.env.example names instead.
JWT_KEY=replace-with-a-private-random-key-at-least-32-bytes

ADMIN_USERNAME=systemadmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

VITE_SPORTS_CENTER_ID=1

R2_SERVICE_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=replace-with-access-key
R2_SECRET_KEY=replace-with-secret-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_DOMAIN=https://your-public-media-domain

# Optional integrations. Configure only the providers you use.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_ENABLE_SSL=true
EMAIL_SMTP_FROM=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
AI_API_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
MOMO_PARTNER_CODE=
MOMO_PAYMENT_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=
MOMO_NOTIFY_URL=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

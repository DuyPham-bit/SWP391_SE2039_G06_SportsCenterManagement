# =================================================================
# SPORTS CENTER MANAGEMENT SYSTEM (SCMS) - DOCKER ENVIRONMENT CONFIG
# =================================================================

# 1. SQL SERVER DATABASE CONFIGURATION
# Replace every value in this file before deployment. Do not commit docker/.env.
MSSQL_SA_PASSWORD=replace-with-a-long-unique-sql-server-password

# 2. DEFAULT ADMIN ACCOUNT (Single Global Admin Policy)
ADMIN_USERNAME=replace-with-admin-username
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password

# 3. SECURITY & AUTHENTICATION
JWT_KEY=replace-with-a-random-private-value-of-at-least-32-bytes

# Keep false for a new Docker SQL Server. Set true only when attaching an existing legacy SCMS database.
DATABASE_BASELINE_LEGACY_SCHEMA=false

# 4. PUBLIC DOMAIN
# The browser only accesses this one HTTPS domain. Nginx proxies /api internally.
FRONTEND_ORIGIN=https://app.example.com

# 5. OPTIONAL SMTP EMAIL
# Leave these blank to disable email OTP. Set them to credentials from your chosen SMTP provider.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_ENABLE_SSL=true
EMAIL_SMTP_FROM=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=

# 6. AI SERVICE CONFIGURATION
# Set your Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
AI_API_KEY=

# 7. HOST-LOCAL SERVICE PORTS
# A host reverse proxy terminates HTTPS and forwards to FRONTEND_PORT. Do not expose SQL/API publicly.
FRONTEND_PORT=3004
BACKEND_PORT=5000

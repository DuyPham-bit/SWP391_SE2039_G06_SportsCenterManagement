# =================================================================
# SPORTS CENTER MANAGEMENT SYSTEM (SCMS) - DOCKER ENVIRONMENT CONFIG
# =================================================================

# 1. SQL SERVER DATABASE CONFIGURATION
MSSQL_SA_PASSWORD=YourStrong@Password123
SQLSERVER_PORT=1433

# 2. DEFAULT ADMIN ACCOUNT (Single Global Admin Policy)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sportscenter.vn
ADMIN_PASSWORD=Admin@SCMS2026!Secure

# 3. SECURITY & AUTHENTICATION
JWT_KEY=SCMS_Secret_Key_For_JWT_Authentication_SportsCenter_2026_Secure!

# 4. SERVICE EXPOSED PORTS
FRONTEND_PORT=3004
BACKEND_PORT=5000

# 5. GEMINI AI (keep the real key only in docker/.env; never commit it)
AI_API_KEY=

# 6. GOOGLE DRIVE OAUTH (optional; keep real values only in docker/.env)
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
